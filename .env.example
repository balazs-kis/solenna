# Copy to .env and fill in. Never commit .env.
# Put a value that contains `$` in single quotes ('like$this'), so compose
# doesn't try to expand it.

# Public URL of the app (used for OAuth redirects)
SOLENNA_BASE_URL=http://localhost:8080
# Optional, defaults to 8080
SOLENNA_PORT=8080
# Directory holding the SQLite database. This value is for local dev;
# compose.yaml overrides it to /data (the mounted volume) in the container.
SOLENNA_DATA_DIR=./data

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
